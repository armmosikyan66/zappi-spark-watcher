# Local test pair with server/.env. On Railway these are service variables.
# Use 127.0.0.1. Nest binds IPv4, and localhost resolves to ::1 first.
NEST_HINT_URL=http://127.0.0.1:3011/api/wallet/sparkscan/hints
SPARKSCAN_HINT_SECRET=
NEST_REGISTRY_URL=http://127.0.0.1:3011/api/internal/watcher/addresses
WATCHER_REGISTRY_SECRET=
WATCHER_CONTROL_SECRET=
PORT=3020
OUTBOX_PATH=data/outbox.sqlite
SPARKSCAN_NETWORK=MAINNET
SPARKSCAN_WS_URL=wss://updates.sparkscan.io/connection/websocket
